# Copy to .env and fill in. .env is git-ignored — secrets never get committed.
SEERR_URL=http://host:5055
SEERR_API_KEY=
PROWLARR_URL=http://host:9696
PROWLARR_API_KEY=
QBIT_URL=http://host:6080
QBIT_USERNAME=admin
QBIT_PASSWORD=
JELLYFIN_URL=http://host:8096
JELLYFIN_API_KEY=
OPENROUTER_API_KEY=
# Host directory holding downloads and library; docker-compose mounts it into
# the container at the same path. Must be one filesystem for hardlinks.
MEDIA_ROOT=/srv/media
LIBRARY_MOVIES=/srv/media/movies
LIBRARY_TV=/srv/media/tv
DOWNLOADS_PATH=/srv/media/torrents
# What qBittorrent calls DOWNLOADS_PATH from inside its own container.
QBIT_PATH_PREFIX=/downloads
