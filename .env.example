# Copy to .env and fill in. .env is git-ignored — secrets never get committed.
SEERR_URL=http://host:5055
SEERR_API_KEY=
PROWLARR_URL=http://host:9696
PROWLARR_API_KEY=
QBIT_URL=http://host:6080
QBIT_USERNAME=admin
QBIT_PASSWORD=
JELLYFIN_URL=http://host:8096
JELLYFIN_API_KEY=
OPENROUTER_API_KEY=
# Host paths (mounted into the container at the same path). Downloads and
# library must be on the same filesystem for hardlinks.
LIBRARY_MOVIES=/mnt/nyxus-vfs/media/movies
LIBRARY_TV=/mnt/nyxus-vfs/media/tv-shows
DOWNLOADS_PATH=/mnt/nyxus-vfs/torrents
# What qBittorrent calls DOWNLOADS_PATH from inside its own container.
QBIT_PATH_PREFIX=/downloads
